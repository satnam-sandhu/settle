# Supabase Configuration
# Copy this file to .env and fill in your values
#   cp .env.example .env

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# PostHog Analytics
# Set to false during local development to avoid sending events to production
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Push notifications (Expo + Supabase send-notification)
# Set to false to skip token registration and hide the Profile toggle
EXPO_PUBLIC_NOTIFICATIONS_ENABLED=true
